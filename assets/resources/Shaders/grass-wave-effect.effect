// grass-wave-alpha-blend.effect
CCEffect %{
  techniques:
  - name: transparent
    passes:
    - vert: grass-vs
      frag: grass-fs
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
      rasterizerState:
        cullMode: back
      properties:
        mainTexture: { value: white }
        waveHeight: { value: 0.5 }
        waveSpeed: { value: 1.5 }
        waveFrequency: { value: 2.0 }
        swayAmount: { value: 0.4 }
        bendAmount: { value: 0.3 }
        windDirectionX: { value: 1.0 }
        windDirectionZ: { value: 0.5 }
        grassHeight: { value: 1.0 }
        colorVariation: { value: 0.2 }
}%

CCProgram grass-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <builtin/uniforms/cc-local>

  in vec3 a_position;
  in vec2 a_texCoord;
  in vec3 a_normal;

  out vec2 v_uv;
  out float v_height;
  out vec3 v_worldPos;

  uniform Properties {
    float waveHeight;
    float waveSpeed;
    float waveFrequency;
    float swayAmount;
    float bendAmount;
    float windDirectionX;
    float windDirectionZ;
    float grassHeight;
    float colorVariation;
  };

  void main() {
    vec3 pos = a_position;
    v_uv = a_texCoord;

    float heightFactor = pos.y / grassHeight;
    heightFactor = clamp(heightFactor, 0.0, 1.0);
    v_height = heightFactor;

    vec4 worldPos = cc_matWorld * vec4(pos, 1.0);
    v_worldPos = worldPos.xyz;
    
    float time = cc_time.x;

    // Wave calculations
    float wave1 = sin(worldPos.x * waveFrequency + time * waveSpeed) * 
                  cos(worldPos.z * waveFrequency * 0.7 + time * waveSpeed * 0.8);
    
    float wave2 = sin(worldPos.z * waveFrequency * 0.5 + time * waveSpeed * 1.3) * 
                  cos(worldPos.x * waveFrequency * 0.8 + time * waveSpeed * 0.6);
    
    float wave = (wave1 + wave2) * 0.5;

    vec2 windDir = normalize(vec2(windDirectionX, windDirectionZ) + 0.001);
    float windInfluence = dot(windDir, vec2(1.0, 0.0)) * wave;
    windInfluence += dot(windDir, vec2(0.0, 1.0)) * sin(time * 0.4 + worldPos.x * 0.5);
    windInfluence *= 0.5;

    float swayStrength = heightFactor * swayAmount;
    float bend = pow(heightFactor, 1.5) * bendAmount;

    float combinedWave = wave * waveHeight + windInfluence * 0.3;
    
    float offsetX = combinedWave * swayStrength * 1.2;
    offsetX += windDir.x * bend * 0.5;
    
    float offsetZ = combinedWave * swayStrength * 0.6;
    offsetZ += windDir.y * bend * 0.3;

    pos.x += offsetX;
    pos.z += offsetZ;

    vec4 finalPos = cc_matViewProj * cc_matWorld * vec4(pos, 1.0);
    gl_Position = finalPos;
  }
}%

CCProgram grass-fs %{
  precision highp float;

  layout(location = 0) out vec4 cc_FragColor;

  in vec2 v_uv;
  in float v_height;
  in vec3 v_worldPos;

  uniform sampler2D mainTexture;

  uniform Properties {
    float waveHeight;
    float waveSpeed;
    float waveFrequency;
    float swayAmount;
    float bendAmount;
    float windDirectionX;
    float windDirectionZ;
    float grassHeight;
    float colorVariation;
  };

  void main() {
    vec4 color = texture(mainTexture, v_uv);
    
    // Add subtle color variation
    float variation = sin(v_worldPos.x * 20.0 + v_worldPos.z * 15.0 + v_height * 10.0) * colorVariation + 1.0;
    color.rgb *= variation;
    
    // Darken base slightly
    float heightDarken = 1.0 - (1.0 - v_height) * 0.2;
    color.rgb *= heightDarken;
    
    cc_FragColor = color;
  }
}%